    {
      "dot": "cyan",
      "title": "运行时",
      "items": [
        "每个 QQ 会话一个 DSH Session；preset 决定工具清单",
        "主人私聊 full、群聊与他人私聊 social；无宿主会话服务时回退 oneshot"
      ]
    },
    {
      "dot": "emerald",
      "title": "认知内核",
      "items": [
        "回合前注入人格/情绪/关系/记忆；回合后做结果归因与长期状态更新",
        "不做重复的 compose 调用，避免 token 翻倍"
      ]
    },
    {
      "dot": "rose",
      "title": "安全边界",
      "items": [
        "入站访问闸门 + 出站统一闸门；工具按档位与逐项权限再校验",
        "dryRun 与审计贯穿回复、撤回、主动行为"
      ]
    }
